{
  "policy_version": "4.0.0",
  "execution": "native_subagents",
  "model_selection": "latest_available_per_family_at_run_start",
  "allowed_families": [
    "sol",
    "terra"
  ],
  "forbidden_families": [
    "luna",
    "astra",
    "jev"
  ],
  "max_coordinator_workers": 3,
  "allow_resume": false,
  "allow_worker_dispatch": false,
  "fast_profile_amount_limit": null,
  "profiles": {
    "hizli": {
      "max_input_tokens": 8000000,
      "max_wall_seconds": 1500,
      "max_revisions": 1
    },
    "standart": {
      "max_input_tokens": 25000000,
      "max_wall_seconds": 3600,
      "max_revisions": 1
    },
    "yuksek_guvence": {
      "max_input_tokens": 50000000,
      "max_wall_seconds": 7200,
      "max_revisions": 2
    }
  },
  "main_session": {
    "allowed_families": [
      "sol",
      "terra"
    ],
    "selection": "latest_available",
    "reasoning_effort": "user_selected"
  },
  "roles": {
    "extraction": {
      "family": "terra",
      "reasoning_effort": "medium"
    },
    "extraction_difficult": {
      "family": "terra",
      "reasoning_effort": "high"
    },
    "requirements": {
      "family": "terra",
      "reasoning_effort": "high"
    },
    "targeted_review": {
      "family": "terra",
      "reasoning_effort": "high",
      "profiles": [
        "hizli"
      ]
    },
    "blind_review": {
      "family": "sol",
      "reasoning_effort": "high",
      "profiles": [
        "standart",
        "yuksek_guvence"
      ]
    },
    "adjudicator": {
      "family": "sol",
      "reasoning_effort": "high"
    },
    "technical": {
      "family": "terra",
      "reasoning_effort": "high",
      "profiles": [
        "yuksek_guvence"
      ]
    },
    "financial": {
      "family": "terra",
      "reasoning_effort": "high",
      "profiles": [
        "yuksek_guvence"
      ]
    },
    "contracts": {
      "family": "terra",
      "reasoning_effort": "high",
      "profiles": [
        "yuksek_guvence"
      ]
    },
    "decision_summary": {
      "family": "sol",
      "reasoning_effort": "high"
    }
  },
  "budget_counting": "last_cumulative_once_per_unique_session_plus_main_delta",
  "budget_warning_ratio": 0.8,
  "transfer_scope": "User-requested analysis within the configured OpenAI account; no repeated consent per allowed role. New providers, recipients and publication require separate authorization.",
  "notes": [
    "Resolve real offered model IDs and supported efforts for every new run; no fabricated aliases or silent fallback.",
    "Record actual session model and reasoning effort, not only requested values.",
    "Business rules remain source-backed; incomplete critical evidence prevents a final recommendation."
  ],
  "catalog_max_age_seconds": 300
}
