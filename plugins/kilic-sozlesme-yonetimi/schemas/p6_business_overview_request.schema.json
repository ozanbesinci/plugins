{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "scope_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "selected_versions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "as_of",
    "scope_keys",
    "selected_versions",
    "context_version"
  ]
}
