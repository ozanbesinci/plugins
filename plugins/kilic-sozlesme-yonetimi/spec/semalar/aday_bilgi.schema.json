{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sözleşme aday bilgisi - yetki veya doğrulama kaydı değildir",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_record_id": {
      "type": "string",
      "format": "uuid"
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "knowledge_kind": {
      "enum": [
        "DOCUMENT_TEXT",
        "USER_STATEMENT",
        "INFERENCE",
        "PROPOSAL"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "value",
            "reason"
          ]
        }
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_excerpt": {
      "type": "string",
      "minLength": 1
    },
    "meaning_status": {
      "enum": [
        "CLEAR",
        "UNCERTAIN",
        "CONFLICTING"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "source_record_id",
    "field",
    "knowledge_kind",
    "value",
    "unit",
    "currency",
    "source_excerpt",
    "meaning_status"
  ]
}
