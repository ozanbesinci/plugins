{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "obligation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "event_date_fact_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "reports_completion": {
      "type": "boolean"
    }
  },
  "required": [
    "obligation_id",
    "source_node_id",
    "description",
    "event_date_fact_id",
    "reports_completion"
  ]
}
