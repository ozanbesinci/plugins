{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p5-docx-1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "reading_id": {
            "type": "string",
            "format": "uuid"
          },
          "unit_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "part": {
            "const": "word/document.xml"
          },
          "path": {
            "type": "string",
            "maxLength": 12000
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "old_text": {
            "type": "string",
            "maxLength": 20000
          },
          "new_text": {
            "type": "string",
            "maxLength": 20000
          },
          "revision_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{1,10}$"
            }
          }
        },
        "required": [
          "source_version_id",
          "reading_id",
          "unit_id",
          "part",
          "path",
          "start",
          "end",
          "old_text",
          "new_text",
          "revision_ids"
        ]
      }
    },
    "allowed_modified_parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "protected_parts": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "word_qa": {
      "const": "NOT_RUN"
    },
    "visual_qa": {
      "const": "NOT_RUN"
    },
    "production_ready": {
      "const": false
    },
    "comments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "audience": {
            "enum": [
              "INTERNAL",
              "EXTERNAL"
            ]
          },
          "comment_id": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
          },
          "anchor_revision_id": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
          }
        },
        "required": [
          "change_index",
          "text",
          "audience",
          "comment_id",
          "anchor_revision_id"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "operation_id",
    "artifact_version_id",
    "source_version_id",
    "source_sha256",
    "artifact_sha256",
    "request_digest",
    "author",
    "created_at",
    "changes",
    "allowed_modified_parts",
    "protected_parts",
    "word_qa",
    "visual_qa",
    "production_ready"
  ]
}
