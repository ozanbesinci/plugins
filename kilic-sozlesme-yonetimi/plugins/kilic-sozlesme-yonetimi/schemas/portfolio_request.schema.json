{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K27 explicit-case portfolio request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scope_keys": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
    },
    "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "format": "uuid"},
          "expected_revision": {"type": "integer", "minimum": 0},
          "selected_versions": {
            "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          }
        },
        "required": ["case_id", "expected_revision", "selected_versions"]
      }
    }
  },
  "required": ["request_id", "purpose", "as_of", "scope_keys", "policy_version", "cases"]
}
