{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "reviewed_pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "page",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "draft_id",
    "case_id",
    "context_version",
    "request_id",
    "manifest_sha256",
    "decision",
    "observation",
    "reviewed_pages"
  ]
}
