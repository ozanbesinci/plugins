{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "selected_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "partial_review": {
      "type": "boolean"
    },
    "mode": {
      "const": "INTERNAL_DRAFT"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "kind": {
            "enum": [
              "DRAFT_TEXT",
              "USER_STATEMENT",
              "SOURCE_EXCERPT"
            ]
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "heading",
          "text",
          "kind",
          "node_ids"
        ]
      }
    }
  },
  "required": [
    "request_id",
    "case_id",
    "context_version",
    "selected_versions",
    "policy_version",
    "partial_review",
    "mode",
    "title",
    "sections"
  ]
}
