{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "internal-draft-1.0"
    },
    "draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "const": "INTERNAL_DRAFT"
    },
    "state": {
      "enum": [
        "PREPARING",
        "REVIEW_PENDING",
        "PUBLISHING",
        "PUBLISHED",
        "REJECTED",
        "QUARANTINED"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "draft_id": {
              "type": "string",
              "format": "uuid"
            },
            "case_id": {
              "type": "string",
              "format": "uuid"
            },
            "context_version": {
              "type": "integer",
              "minimum": 0
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "docx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32768
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "pdf": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32768
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "page",
                  "path",
                  "sha256"
                ]
              }
            },
            "renderer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "exe_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "adapter_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "name",
                "version",
                "exe_sha256",
                "adapter_sha256"
              ]
            },
            "structural_qa": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "passed": {
                  "const": true
                },
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "required": [
                "passed",
                "checks"
              ]
            },
            "render_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "draft_id",
            "case_id",
            "context_version",
            "request_digest",
            "source_fingerprint",
            "docx",
            "pdf",
            "pages",
            "renderer",
            "structural_qa",
            "render_sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "final_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_scope": {
      "const": "MODEL_VISUAL_REVIEW_ONLY"
    },
    "authority": {
      "const": "NOT_VERIFIED"
    },
    "business_acceptance": {
      "const": "NOT_GRANTED"
    },
    "critical_analysis_allowed": {
      "const": false
    },
    "source_mutation": {
      "const": "NONE"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "draft_id",
    "case_id",
    "request_id",
    "context_version",
    "mode",
    "state",
    "request_digest",
    "manifest_sha256",
    "manifest",
    "final_path",
    "review_scope",
    "authority",
    "business_acceptance",
    "critical_analysis_allowed",
    "source_mutation",
    "error_code"
  ]
}
