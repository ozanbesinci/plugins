{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "REFERENCE_ONLY",
            "SELECTED_CURRENT_TARGET"
          ]
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_file_matches_snapshot": {
          "type": "boolean"
        },
        "decision_authority": {
          "const": "NONE"
        }
      },
      "required": [
        "role",
        "version_id",
        "sha256",
        "size_bytes",
        "original_file_matches_snapshot",
        "decision_authority"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "source-comparison-1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "reference": {
      "$ref": "#/$defs/version"
    },
    "target": {
      "$ref": "#/$defs/version"
    },
    "same_bytes": {
      "type": "boolean"
    },
    "first_changed_byte": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "comparison_scope": {
      "enum": [
        "BYTES_ONLY",
        "EXTRACTED_TEXT_ONLY"
      ]
    },
    "semantic_comparison": {
      "const": "NOT_RUN"
    },
    "critical_analysis_allowed": {
      "const": false
    },
    "authority": {
      "const": "NOT_VERIFIED"
    },
    "business_acceptance": {
      "const": "NOT_GRANTED"
    },
    "source_mutation": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "DOCX",
            "PDF",
            "XLSX",
            "EML"
          ]
        },
        "view": {
          "enum": [
            "RAW",
            "BEFORE",
            "AFTER",
            "DISPLAY"
          ]
        },
        "reader_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_reading_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_reading_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "part": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "sheet": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cell": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "part",
                  "path",
                  "page",
                  "sheet",
                  "cell"
                ]
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                },
                "maxItems": 1000
              }
            },
            "required": [
              "unit_id",
              "locator",
              "kind",
              "text",
              "attributes"
            ]
          },
          "maxItems": 512
        },
        "target_units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "part": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "sheet": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cell": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "part",
                  "path",
                  "page",
                  "sheet",
                  "cell"
                ]
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                },
                "maxItems": 1000
              }
            },
            "required": [
              "unit_id",
              "locator",
              "kind",
              "text",
              "attributes"
            ]
          },
          "maxItems": 512
        },
        "reference_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "locator": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "part": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "sheet": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cell": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "part",
                      "path",
                      "page",
                      "sheet",
                      "cell"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "severity": {
                "enum": [
                  "INFO",
                  "WARNING",
                  "BLOCKING"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "locator",
              "severity"
            ]
          },
          "maxItems": 20000
        },
        "target_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "locator": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "part": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "sheet": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cell": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "part",
                      "path",
                      "page",
                      "sheet",
                      "cell"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "severity": {
                "enum": [
                  "INFO",
                  "WARNING",
                  "BLOCKING"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "locator",
              "severity"
            ]
          },
          "maxItems": 20000
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "enum": [
                  "replace",
                  "delete",
                  "insert"
                ]
              },
              "reference_start": {
                "type": "integer",
                "minimum": 0
              },
              "reference_end": {
                "type": "integer",
                "minimum": 0
              },
              "target_start": {
                "type": "integer",
                "minimum": 0
              },
              "target_end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "operation",
              "reference_start",
              "reference_end",
              "target_start",
              "target_end"
            ]
          },
          "maxItems": 1024
        },
        "same_text": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "view",
        "reader_profile_digest",
        "reference_reading_digest",
        "target_reading_digest",
        "reference_units",
        "target_units",
        "reference_issues",
        "target_issues",
        "changes",
        "same_text"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "document_id",
    "context_version",
    "reference",
    "target",
    "same_bytes",
    "first_changed_byte",
    "comparison_scope",
    "semantic_comparison",
    "critical_analysis_allowed",
    "authority",
    "business_acceptance",
    "source_mutation",
    "limitations"
  ]
}
