{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-text rebind of stale source nodes to the current reader profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rebind-1.0"},
    "case_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "string"},
    "basis_revision": {"type": "integer", "minimum": 0},
    "final_revision": {"type": "integer", "minimum": 0},
    "mapping": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "properties": {"old_node_id": {"type": "string", "format": "uuid"}, "new_node_id": {"type": "string", "format": "uuid"},
                     "reused": {"type": "boolean"}},
      "required": ["old_node_id", "new_node_id", "reused"]}},
    "unmapped": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "properties": {"node_id": {"type": "string", "format": "uuid"},
                     "reason": {"enum": ["UNIT_NOT_IN_CURRENT_READING", "TEXT_CHANGED_IN_CURRENT_READING"]}},
      "required": ["node_id", "reason"]}},
    "skipped": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "properties": {"node_id": {"type": "string", "format": "uuid"}, "node_kind": {"type": "string"},
                     "reasons": {"type": "array", "items": {"type": "string"}}},
      "required": ["node_id", "node_kind", "reasons"]}},
    "relations": {"type": "object", "additionalProperties": false,
      "properties": {"created": {"type": "integer", "minimum": 0}, "reused": {"type": "integer", "minimum": 0},
                     "superseded": {"type": "integer", "minimum": 0},
                     "unmapped": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                       "properties": {"relation_id": {"type": "string", "format": "uuid"},
                                      "reason": {"enum": ["RELATION_INVALIDATED", "SOURCE_NOT_REBOUND", "TARGET_NOT_REBOUND"]}},
                       "required": ["relation_id", "reason"]}}},
      "required": ["created", "reused", "superseded", "unmapped"]},
    "readings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "properties": {"version_id": {"type": "string", "format": "uuid"}, "format": {"type": "string"},
                     "processing_id": {"type": "string", "format": "uuid"}, "reused": {"type": "boolean"}},
      "required": ["version_id", "format", "processing_id", "reused"]}},
    "business_records_review_required": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "properties": {"record_id": {"type": "string", "format": "uuid"}, "table": {"type": "string"},
                     "reason": {"const": "REFERENCES_REBOUND_NODE"}},
      "required": ["record_id", "table", "reason"]}},
    "old_records_retained": {"const": true},
    "semantic_change": {"const": "NONE_EXACT_TEXT_MATCH"},
    "authority": {"const": "NOT_VERIFIED"},
    "business_acceptance": {"const": "NOT_GRANTED"}
  },
  "required": ["schema_version", "case_id", "policy_version", "basis_revision", "final_revision", "mapping", "unmapped",
               "skipped", "relations", "readings", "business_records_review_required", "old_records_retained",
               "semantic_change", "authority", "business_acceptance"]
}
