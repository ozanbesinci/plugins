{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kontrol sonucu - yalnız güvenilir doğrulayıcı üretir",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checker_version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "FILE_INTEGRITY",
              "STRUCTURE",
              "COVERAGE",
              "FIDELITY",
              "SEMANTICS",
              "OUTPUT_LAYOUT"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "PASS",
              "PARTIAL",
              "FAIL",
              "NOT_CHECKED"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dimension",
          "scope",
          "method",
          "outcome",
          "details"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "source_version_id",
    "source_sha256",
    "checker_version",
    "checks",
    "limitations"
  ]
}
